{
  "mcpServers": {
    "context7": {
      "command": "cmd",
      "args": ["/c", "npx", "-y", "@upstash/context7-mcp@latest"]
    },
    "playwright": {
      "command": "cmd",
      "args": ["/c", "npx", "-y", "@playwright/mcp@latest"]
    },
    "postgres": {
      "command": "uv",
      "args": ["run", "--quiet", "python", "tools_mcp/pg_readonly_mcp.py"],
      "env": {
        "DATABASE_URI": "postgresql://mcp_readonly@127.0.0.1:5432/traffic",
        "UV_SYSTEM_CERTS": "1"
      }
    }
  }
}
