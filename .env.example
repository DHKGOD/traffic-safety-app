# ===== 交通安全路口提醒 App 設定範本 =====
# 複製成 .env 後修改（或執行 `uv run python scripts/setup_env.py` 自動產生並填入隨機密碼）。
# .env 不進 Git；換主機時只改這個檔案。

# --- 資料庫模式 ---
# local    ：使用專案資料夾內的 PostgreSQL（tools/pgsql + db/pgdata），一鍵啟動會一併啟動資料庫
# external ：資料庫由主機或雲端服務提供，一鍵啟動只啟動 API（DATABASE_URL 指向外部資料庫）
DB_MODE=local

# --- PostgreSQL 連線 ---
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=traffic
# 超級使用者（只用於建立資料庫、角色與 extension；external 模式若無權限可留空，改由管理員先建好）
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change-me-superuser
# App 使用的帳號（API 與匯入腳本）
APP_DB_USER=traffic_app
APP_DB_PASSWORD=change-me-app
# 完整連線字串（API 實際使用這個；與上面的值保持一致）
DATABASE_URL=postgresql://traffic_app:change-me-app@127.0.0.1:5432/traffic

# --- local 模式專用 ---
# PostgreSQL 執行檔目錄；留空＝自動找 %LOCALAPPDATA%\Programs\pgsql18\bin（見 scripts/install_postgres.ps1）或 PATH
# （Windows 版 PostgreSQL 程式路徑不能有中文，所以不放在專案資料夾；資料目錄 PGDATA 仍在專案內）
PG_BIN=
PGDATA=db/pgdata

# --- API 伺服器 ---
API_HOST=0.0.0.0
API_PORT=8000
# 對外網址（雲端主機的網域，例如 https://traffic.example.edu.tw）；留空則自動偵測區網 IP
PUBLIC_API_BASE=
# 允許的前端來源（逗號分隔；* 代表全部，開發期使用）
CORS_ORIGINS=*

# --- AI 模型 ---
MODEL_DIR=ai/models
